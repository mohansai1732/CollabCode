# CollabCode Backend Environment Configuration Template
# Copy this file to .env and provide your actual values.
# NEVER commit .env with real secrets to Git.

PORT=5001
CLIENT_URL=http://localhost:5173
JSON_LIMIT=4mb

# Clerk Authentication (Clerk Dashboard -> API Keys)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sandbox Code Execution Service URL
SANDBOX_SERVICE_URL=http://localhost:2000

# Firebase Service Account (JSON string for production on Render)
FIREBASE_SERVICE_ACCOUNT_JSON=

# ==========================================================
# Dedicated Admin Portal Access & Security
# ==========================================================
# Dedicated Admin secret (plaintext or preferably SHA-256 hash)
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# Dedicated Admin Session Signing Secret (optional random seed)
ADMIN_SESSION_SECRET=

# Email address to receive security attempt notifications
ADMIN_ALERT_EMAIL=

# Optional SMTP Settings for Live Email Delivery
# (If omitted, security events are logged to console and Firestore admin_security_logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SERVICE=
SMTP_FROM=
